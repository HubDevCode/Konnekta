{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konnekta",
  "version": "0.1.0",
  "identifier": "org.konnekta.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Konnekta",
        "width": 1180,
        "height": 780,
        "minWidth": 780,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Connect your phone and computer",
    "longDescription": "Konnekta links phones and computers: clipboard, files, media, notifications, calls, remote input, wireless microphone and webcam, remote desktop and a Stream Deck-like Mobile Deck. Compatible with KDE Connect.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "wl-clipboard", "playerctl", "ffmpeg"]
      },
      "rpm": {
        "depends": ["libappindicator-gtk3", "wl-clipboard", "playerctl", "ffmpeg"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
